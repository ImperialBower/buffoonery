package imperialbower:solver@0.1.0;

/// Score a Balatro board and explain the score (EPIC-05 Story 4).
interface calculator {
    /// A custom effect: a card or joker with `Custom(id)` applies `op`, a
    /// `ScoreOp` as JSON (e.g. `{"TimesMult": 2.0}`), every time it scores.
    record custom-effect {
        id: u32,
        op: string,
    }

    /// How `score-with` scores a board.
    record score-options {
        /// Rolls the chances (Lucky cards, Misprint) from this seed; the same
        /// board and seed give the same trace. None: each chance scores its
        /// floor, as in `score`.
        seed: option<u64>,
        /// What each `Custom(id)` does. An id with no entry does nothing.
        effects: list<custom-effect>,
    }

    /// A `BoardSpec` as JSON or YAML in; its `ScoreTrace` as JSON out. The
    /// error names the bad field, e.g. `jokers[1]: unknown joker ident "X"`.
    score: func(spec: string) -> result<string, string>;
    /// Like `score`, with a seed for the chances and custom effects for
    /// `Custom(id)` cards and jokers. Rolled steps carry `"rolled": true`.
    score-with: func(spec: string, options: score-options) -> result<string, string>;
    /// A `BoardSpec` as JSON or YAML in; the same spec as JSON out, so a host
    /// can read a YAML board without a YAML parser. Checks the shape only:
    /// an unknown joker or card is reported by `score`.
    parse: func(spec: string) -> result<string, string>;
    /// Every joker as JSON: ident, name, rarity, cost, effect, blank reason.
    catalog: func() -> string;
    /// The buffoonery engine version that scores the boards.
    version: func() -> string;
}

world joker-calculator {
    export calculator;
}
